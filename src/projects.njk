---
layout: layouts/base.njk
title: Projects
description: Current and past research and applied software projects.
---
{% include "partials/related-work-nav.njk" %}
<header class="page-hero page-hero-compact shell">
  <p class="eyebrow">Research & practice</p>
  <h1>Projects</h1>
  <p class="lede">Research and applied collaborations across sustainable software, AI engineering, self-adaptation, CloudOps, cultural heritage, and education.</p>
</header>
<section class="section shell section-rule">
  <div class="project-grid">
    {% for project in projects %}
      <article class="project-card">
        <p class="project-role">{{ project.role }}</p>
        <h2>{{ project.title }}</h2>
        <p>{{ project.description }}</p>
        <p class="project-collaboration">{{ project.collaboration }}</p>
        <a class="text-link" href="/projects/{{ project.slug }}/">Project details <span aria-hidden="true">→</span></a>
      </article>
    {% endfor %}
  </div>
</section>
