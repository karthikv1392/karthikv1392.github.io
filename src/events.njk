---
layout: layouts/base.njk
title: Events & Programmes
description: Upcoming learning programmes and selected seminars, tutorials, organizing roles, and invited appearances.
permalink: /events/
---
<header class="page-hero page-hero-compact shell">
  <p class="eyebrow">Events & programmes</p>
  <h1>Where ideas meet practice.</h1>
  <p class="lede">Upcoming learning programmes alongside selected seminars, tutorials, organizing roles, and invited appearances.</p>
</header>

{% include "partials/upcoming-program.njk" %}

<section class="section shell section-rule">
  <div class="section-heading compact-heading">
    <div>
      <p class="eyebrow">Archive</p>
      <h2>Recent events</h2>
    </div>
  </div>
  <ol class="appearance-list">
    {% for appearance in appearances %}
      <li>
        <p class="appearance-date">{{ appearance.date }}</p>
        <div>
          <p class="appearance-role">{{ appearance.role }}</p>
          <h2 class="event-title">{{ appearance.title }}</h2>
          <p>{{ appearance.place }}</p>
        </div>
      </li>
    {% endfor %}
  </ol>
  <p class="archive-link"><a class="button button-secondary" href="/talks/">Complete talks archive</a></p>
</section>
