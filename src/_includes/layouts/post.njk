---
layout: layouts/base.njk
---
<article class="post shell">
  <header class="post-header">
    <p class="eyebrow">News</p>
    <h1>{{ title }}</h1>
    <p><time datetime="{{ date | htmlDate }}">{{ date | readableDate }}</time></p>
  </header>
  <div class="post-body prose">
    {{ content | safe }}
  </div>
  <footer class="post-footer">
    <a class="text-link" href="/news/">Back to news <span aria-hidden="true">→</span></a>
  </footer>
</article>
