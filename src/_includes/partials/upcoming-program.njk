<section class="closing shell program-feature" aria-labelledby="upcoming-program-title">
  <p class="eyebrow">{{ upcomingProgram.eyebrow }}</p>
  <h2 id="upcoming-program-title"><a href="{{ upcomingProgram.url }}">{{ upcomingProgram.title }}</a></h2>
  <p>{{ upcomingProgram.description }}</p>
  <p class="program-meta"><strong>{{ upcomingProgram.provider }}</strong> · {{ upcomingProgram.role }}<br>
    {{ upcomingProgram.format }}<br>
    {{ upcomingProgram.applicationDeadline }} · {{ upcomingProgram.start }}</p>
  <a class="button button-primary" href="{{ upcomingProgram.url }}">Programme details and applications <span aria-hidden="true">→</span></a>
</section>
